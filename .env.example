# Copie para .env e ajuste. NUNCA versione o arquivo .env com valores reais.

# ---- Banco de dados (PostgreSQL) ----
DB_NAME=edufin
DB_USERNAME=edufin
DB_PASSWORD=troque-esta-senha
# Fora do docker compose, informe a URL JDBC completa:
# DB_URL=jdbc:postgresql://localhost:5432/edufin

# ---- Administrador inicial (criado só se ainda não existir) ----
# A senha precisa ter de 8 a 72 caracteres, com letras e números. Troque-a após o primeiro acesso.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-1

# ---- Aplicação ----
APP_PUBLIC_URL=http://localhost:8080
# Em produção (HTTPS) use true para o cookie de sessão só trafegar por conexão segura.
COOKIE_SECURE=false
SESSION_TIMEOUT=2h
# Desative a documentação interativa da API em produção, se desejar.
API_DOCS_ENABLED=true
# Origens extras autorizadas (separadas por vírgula). Vazio = apenas a mesma origem.
CORS_ALLOWED_ORIGINS=
# Cadastros permitidos por IP por hora (escolas costumam compartilhar um IP).
RATE_LIMIT_REGISTRATIONS_PER_HOUR=30

# ---- E-mail (recuperação de senha). Desativado por padrão. ----
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Retenção de dados (dias) ----
RETENTION_ACTIVITY_DAYS=365
RETENTION_NOTIFICATION_DAYS=180
